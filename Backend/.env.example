# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database ---
DATABASE_URL=mysql+pymysql://uf_app:CHANGE_ME@localhost:3306/urban_furniture_db?charset=utf8mb4

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- Frontend (used only to build the password reset link) ---
FRONTEND_URL=http://localhost:5173

# --- App ---
ENVIRONMENT=development
UPLOAD_DIR=app/static/uploads
MAX_UPLOAD_SIZE_MB=2
